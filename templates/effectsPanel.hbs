<form class="vn-fx-panel flexcol">

    <div class="vn-fx-section">
        <label class="vn-fx-label">Цель эффекта</label>
        <select class="vn-fx-target-select">
            <option value="all">Все активные персонажи</option>
            {{#each targets as |t|}}
                <option value="{{t.pos}}">{{t.name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="vn-fx-section vn-fx-row">
        <button type="button" class="vn-fx-shake"><i class="fas fa-hand-fist"></i> Тряска</button>
    </div>

    <div class="vn-fx-section vn-fx-row">
        <button type="button" class="vn-fx-flash-light"><i class="fas fa-sun"></i> Вспышка света</button>
        <button type="button" class="vn-fx-flash-dark"><i class="fas fa-moon"></i> Вспышка тьмы</button>
    </div>

    <hr/>

    <div class="vn-fx-section vn-fx-row">
        <button type="button" class="vn-fx-toggle-darken{{#if darkenBack}} vn-fx-active{{/if}}">
            <i class="fas fa-circle-half-stroke"></i> Затемнить фон
        </button>
        <button type="button" class="vn-fx-toggle-row{{#if rowMode}} vn-fx-active{{/if}}">
            <i class="fas fa-grip-lines"></i> Режим ряда
        </button>
    </div>

    <div class="vn-fx-section vn-fx-row">
        <button type="button" class="vn-fx-bgscroll-toggle{{#if bgScroll}} vn-fx-active{{/if}}">
            <i class="fas fa-arrows-left-right"></i> Прокрутка фона
        </button>
        <button type="button" class="vn-fx-blur-toggle{{#if bgBlur}} vn-fx-active{{/if}}">
            <i class="fas fa-droplet"></i> Блюр фона
        </button>
    </div>

    <div class="vn-fx-section vn-fx-row">
        <button type="button" class="vn-fx-narrative">
            <i class="fas fa-align-center"></i> Нарратив
        </button>
    </div>

    <hr/>

    <div class="vn-fx-section vn-fx-row">
        <button type="button" class="vn-fx-toggle-lockexit{{#if lockExit}} vn-fx-active{{/if}}">
            <i class="fas fa-lock"></i> Заблокировать выход игрокам
        </button>
    </div>

    <p class="vn-fx-hint">Тряска и вспышки применяются к выбранной выше цели. Затемнение фона, режим ряда, прокрутка фона, блюр фона и блокировка выхода - это переключатели, общие для всех игроков.</p>

</form>
